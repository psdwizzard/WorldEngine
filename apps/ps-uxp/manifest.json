{
  "manifestVersion": 5,
  "id": "com.worldengine.photoshop",
  "name": "WorldEngine",
  "version": "0.1.3",
  "main": "plugin.js",
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/pluginIcon.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "light", "lightest", "all"]
    }
  ],
  "host": [
    {
      "app": "PS",
      "minVersion": "23.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "worldengine.panel",
      "label": "WorldEngine",
      "minimumSize": {
        "width": 320,
        "height": 520
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 720
      },
    "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "light", "lightest", "all"]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess"
  }
}
