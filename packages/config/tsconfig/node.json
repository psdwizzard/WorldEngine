{
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vitest"],
    "baseUrl": "../../..",
    "paths": {
      "@worldengine/shared": ["packages/shared/src/index.ts"],
      "@worldengine/shared/*": ["packages/shared/src/*"]
    }
  },
  "include": ["src", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}