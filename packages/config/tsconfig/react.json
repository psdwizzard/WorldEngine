{
  "extends": "./base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client", "vitest"],
    "baseUrl": "../../..",
    "paths": {
      "@worldengine/shared": ["packages/shared/src/index.ts"],
      "@worldengine/shared/*": ["packages/shared/src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}