NODE_ENV=production
PORT=4000
HOST=0.0.0.0
DATA_ROOT=E:\app\WorldEngine\workspace-data

# Shared founder-managed Gemini key. Do not expose this in browser settings.
GEMINI_API_KEY=replace-with-founder-gemini-key

# Hosted mode: accept either Cloudflare Access JWTs or signed Forge proxy headers.
WORLDENGINE_HOSTED_BY_FORGE=1
WORLDENGINE_REQUIRE_AUTH=1
WORLDENGINE_FOUNDER_EMAIL=k.loebenberg@gmail.com
WORLDENGINE_PROXY_HMAC_SECRET=replace-with-darkfoundry-app-proxy-secret
CLOUDFLARE_ACCESS_TEAM_DOMAIN=psdwizzard.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=replace-with-worldengine-access-aud
