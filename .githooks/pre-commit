#!/usr/bin/env node

/**
 * Block committing secrets and runtime output.
 * Denies any staged file matching .env* or apps/api/output/**
 */
import { execSync } from "node:child_process";

function getStagedFiles() {
  try {
    return execSync("git diff --cached --name-only --diff-filter=ACM", { encoding: "utf8" })
      .split("\n")
      .map((f) => f.trim())
      .filter(Boolean);
  } catch {
    return [];
  }
}

const forbidden = [
  /\.env(\.|$)/i, // any .env, .env.local, .env.something
  /^apps\/api\/output(\/|$)/, // runtime output
];

const offenders = getStagedFiles().filter((file) => forbidden.some((re) => re.test(file)));

if (offenders.length > 0) {
  console.error("\n✖ Commit blocked: secrets/runtime output detected.");
  offenders.forEach((file) => console.error(` - ${file}`));
  console.error("\nRemove these from the index or move them outside the repo before committing.");
  process.exit(1);
}

process.exit(0);
